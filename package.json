{
  "name": "jovi-creator-os",
  "version": "0.1.0",
  "private": true,
  "description": "Jovi Creator OS — autonomous AI creator system: core brain (Phase 6), planning (Phase 7), creative production (Phase 8).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch apps/api/main.ts",
    "start": "node dist/apps/api/main.js",
    "start:dev": "tsx apps/api/main.ts",
    "jovi": "tsx apps/orchestrator/cli.ts",
    "jovi:providers": "tsx apps/orchestrator/cli.ts --providers",
    "worker": "tsx apps/orchestrator/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/scripts/migrate.ts",
    "db:seed": "tsx src/database/scripts/seed.ts",
    "db:reset": "tsx src/database/scripts/reset.ts",
    "test:lmstudio": "vitest run tests/unit/lmstudio-provider.test.ts tests/integration/lmstudio-flow.e2e.test.ts tests/integration/lmstudio.real.test.ts",
    "test:lmstudio:real": "JOVI_LMSTUDIO_REAL=1 vitest run tests/integration/lmstudio.real.test.ts",
    "jovi:simulate": "tsx apps/orchestrator/cli.ts --simulate",
    "jovi:plan": "tsx apps/orchestrator/cli.ts --plan",
    "jovi:produce": "tsx apps/orchestrator/cli.ts --produce",
    "test:production": "vitest run tests/unit/production-contracts.test.ts tests/unit/media-providers.test.ts tests/integration/production-pipeline.e2e.test.ts",
    "test:production:real": "JOVI_LMSTUDIO_REAL=1 vitest run tests/integration/production.real.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
