# Jovi Creator OS — Jovi Core v0.1 (Phase 6)
# Copy to .env and fill in what you have. NEVER commit .env.
# Only ONE model provider is required. Missing providers report "unavailable".

# --- Database (SQLite) ------------------------------------------------------
# Relative paths resolve against the project root.
DATABASE_URL=data/jovi.db
JOVI_AUTO_SEED=true

# --- Cloud providers (optional) ---------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Preference order when several cloud providers are configured.
# JOVI_CLOUD_PREFERENCE=anthropic,openai,gemini

# --- Local provider: Ollama (optional) ---------------------------------------
OLLAMA_URL=http://localhost:11434
# Preferred local model. If unset or not installed, the first installed chat model is used.
# Models are never downloaded automatically: run `ollama pull <model>` yourself.
OLLAMA_MODEL=
# OLLAMA_ENABLED=true

# --- Mock provider (offline, deterministic, NO real inference) ---------------
# Useful for demos/CI without any model. Results are labeled provider "mock".
JOVI_ENABLE_MOCK_PROVIDER=false

# --- Jobs -------------------------------------------------------------------
# JOVI_JOB_MAX_ATTEMPTS=3
# JOVI_JOB_BACKOFF_MS=2000
# JOVI_WORKER_ENABLED=true
# JOVI_PROVIDER_TIMEOUT_MS=120000

# --- Permissions --------------------------------------------------------------
# Deployment-wide ceiling. Phase 6 never grants external actions (LEVEL_4/5).
# JOVI_MAX_PERMISSION_LEVEL=LEVEL_3_EXECUTE

# --- API --------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
# Optional bearer token for all /api routes (recommended if HOST is not localhost).
JOVI_API_TOKEN=

# --- Logging ------------------------------------------------------------------
JOVI_LOG_LEVEL=info
