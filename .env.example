# Jovi Creator OS — Jovi Core (Phases 6–9)
# Copy to .env and fill in what you have. NEVER commit .env.
# .env is loaded automatically by the API, CLI, worker and db scripts;
# variables already set in your shell take precedence over this file.
# Only ONE model provider is required. Missing providers report "unavailable".

# --- Database (SQLite) ------------------------------------------------------
# Relative paths resolve against the project root.
DATABASE_URL=data/jovi.db
JOVI_AUTO_SEED=true

# --- Local model runtime: LM Studio (the ONLY local runtime) -----------------
# In LM Studio: download a model, load it, then start the local server
# (Developer → Start Server, or `lms server start`). Jovi never downloads or
# loads models itself; until a model is loaded, LM Studio reports "unavailable".
LM_STUDIO_URL=http://localhost:1234/v1
# Model id as shown by LM Studio (`lms ls` / GET /v1/models). If unset, the
# first LOADED chat model is used.
LM_STUDIO_MODEL=
# LM_STUDIO_ENABLED=true
# Only if you enabled API authentication in LM Studio's server settings:
LM_STUDIO_API_KEY=
# Local inference on a laptop can be slow (default 10 minutes).
# LM_STUDIO_TIMEOUT_MS=600000

# --- Cloud providers (optional) ---------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Preference order when several cloud providers are configured.
# JOVI_CLOUD_PREFERENCE=anthropic,openai,gemini
# Cloud request timeout (LM Studio uses LM_STUDIO_TIMEOUT_MS).
# JOVI_PROVIDER_TIMEOUT_MS=120000

# --- Routing ------------------------------------------------------------------
# May LOW-tier (local) tasks use a cloud provider when LM Studio is unavailable?
# JOVI_ALLOW_CLOUD_FALLBACK=true

# --- Simulation (NOT production) ----------------------------------------------
# Registers ONLY a deterministic mock provider (canned output, no inference).
# Never combined with real providers; every result is flagged "simulated": true.
JOVI_SIMULATION_MODE=false

# --- Media generation (Phase 8) ----------------------------------------------
# ComfyUI (local image/video). Unset = NOT_CONFIGURED: image/video assets are
# BLOCKED (never faked). Workflows are API-format JSON exports ("Save (API)")
# containing the placeholders {{POSITIVE_PROMPT}} {{NEGATIVE_PROMPT}} {{WIDTH}}
# {{HEIGHT}} {{SEED}} {{FILENAME_PREFIX}} (+ {{DURATION_SECONDS}} {{FRAMES}} for video).
# Jovi never installs checkpoints/LoRAs: the workflow names what you have.
COMFYUI_URL=
COMFYUI_IMAGE_WORKFLOW=
COMFYUI_VIDEO_WORKFLOW=
# COMFYUI_TIMEOUT_MS=900000
# Generated files are written only under this directory.
# JOVI_MEDIA_DIR=data/media
# JOVI_MEDIA_MAX_ATTEMPTS=2
# Image workflows may also use {{REFERENCE_IMAGE}} (identity conditioning with
# the approved reference sheet); video workflows may use {{SOURCE_IMAGE}}
# (image-to-video) and {{FPS}}.

# --- Real media providers (Phase 9) — every one is opt-in -----------------------
# Try these provider ids first (comma-separated), e.g. "comfyui-image,macos-say".
# JOVI_MEDIA_PROVIDER_PREFERENCE=
# Human-approved reference images (e.g. Jovi's reference sheet) must live here.
# JOVI_REFERENCE_DIR=data/references
# Render engine (edit plan → MP4). macOS: brew install ffmpeg, then
# JOVI_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg (or just "ffmpeg" if on PATH).
JOVI_FFMPEG_PATH=
# Optional: measure durations/dimensions of generated media precisely.
JOVI_FFPROBE_PATH=
# JOVI_FFMPEG_TIMEOUT_MS=600000
# Local voice on macOS: a human-approved system voice (list: say -v '?').
MACOS_SAY_VOICE=
# MACOS_SAY_PATH=/usr/bin/say
# Cloud voice (optional, costs credits; never used for LOCAL_ONLY productions).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# JOVI_VOICE_TIMEOUT_MS=120000
# Google Flow has no executable API integration: it stays NOT_INTEGRATED.

# --- Jobs -------------------------------------------------------------------
# JOVI_JOB_MAX_ATTEMPTS=3
# JOVI_JOB_BACKOFF_MS=2000
# JOVI_WORKER_ENABLED=true
# A job lock not refreshed for this long is treated as abandoned and recovered.
# JOVI_JOB_STALE_MS=300000
# JOVI_JOB_HEARTBEAT_MS=30000

# --- Permissions --------------------------------------------------------------
# Deployment-wide ceiling. Phase 6 never grants external actions (LEVEL_4/5).
# JOVI_MAX_PERMISSION_LEVEL=LEVEL_3_EXECUTE

# --- API --------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
# Every /api route requires a Bearer credential. On first start the API creates an
# "owner" credential and prints its token once; manage more with
#   npm run jovi -- --api-token create --name <name> --scopes read,operate
# Optional operator token (>= 32 characters, e.g. `openssl rand -base64 32`):
JOVI_API_TOKEN=
# During a rollover, the previous operator token stays valid (remove it afterwards):
# JOVI_API_TOKEN_PREVIOUS=
# Scopes for JOVI_API_TOKEN: read, operate, approve, identity-admin
# JOVI_API_TOKEN_SCOPES=read,operate
# Extra Host names / browser origins to accept (localhost, 127.0.0.1, ::1 always are):
# JOVI_ALLOWED_HOSTS=jovi-core
# JOVI_ALLOWED_ORIGINS=https://dashboard.example
# Binding a non-loopback HOST must be explicit (plain HTTP: put TLS in front):
# JOVI_ALLOW_NETWORK_BIND=false
# Expensive endpoints (goal execution, evaluation):
# JOVI_GOAL_RATE_LIMIT_PER_MINUTE=10
# Concurrent model-calling requests, counting unfinished async jobs:
# JOVI_MAX_CONCURRENT_GOALS=2
# Resource limits (security remediation R-05):
# JOVI_MAX_QUEUED_JOBS=20                 # unfinished jobs; more → 429
# JOVI_WRITE_RATE_LIMIT_PER_MINUTE=30     # memory / decision / visual-identity writes per principal
# JOVI_REQUEST_TIMEOUT_MS=30000           # time to receive a whole request (not a handler timeout)
# JOVI_MAX_EXTERNAL_MEMORY_ITEMS=500      # total API-written memory items
# JOVI_MAX_MEDIA_REGENERATIONS=5          # human-requested regenerations per production
# JOVI_MEDIA_QUOTA_MB=20480               # media directory quota; generation is BLOCKED beyond it
# JOVI_SUPERSEDED_RETENTION_DAYS=7        # files of SUPERSEDED media are deleted after this (records kept)
# JOVI_DAILY_CLOUD_BUDGET_USD=10          # estimated cloud spend per UTC day; 0 disables cloud providers

# --- Trust pins (security remediation R-17, optional; see docs/security/trust-model.md) ---
# SHA-256 of executables (their *_PATH must be absolute) and approved ComfyUI workflows.
# JOVI_FFMPEG_SHA256=
# JOVI_FFPROBE_SHA256=
# MACOS_SAY_SHA256=
# COMFYUI_IMAGE_WORKFLOW_SHA256=
# COMFYUI_VIDEO_WORKFLOW_SHA256=

# --- Data retention (security remediation R-18; see docs/security/data-at-rest.md) ---
# JOVI_RUN_RETENTION_DAYS=180             # finished agent/model runs (prompts, outputs)
# JOVI_EVENT_RETENTION_DAYS=0             # 0 = keep the audit log forever

# --- Logging ------------------------------------------------------------------
JOVI_LOG_LEVEL=info
